    private async Task DoSwap()
    {
        try
        {
            IsSubmitting = true;

            var response = await Http.PostAsJsonAsync<List<Tile>>($"/api/Exchange/{GameId}", TilesInRack);
            if (!response.IsSuccessStatusCode)
            {
                MessageForLocalHuman = $"Unable to make move, exchange: {response.StatusCode.ToString()}";
                return;
            }
            var gameDto = await response.Content.ReadFromJsonAsync<GameDto>();

            await ApplyDownloadToGui(currentGame, gameDto);
        }
        catch (Exception ex)
        {
            IsSubmitting = false;
            MyMove = true;

            MessageForLocalHuman = $"Unable to make exchange: {ex.Message}";
            return;

        }
        IsSubmitting = false;

        SwappingTiles.Clear();
        IsSwapping = false;

        StateHasChanged();
    }


    private async Task Play()
    {
        var nPlayed = WordInPlay.Count;

        try
        {
            IsSubmitting = true;
            MyMove = false;

            var placeMoveDto = new PlaceMoveDto();
            placeMoveDto.WordInPlay = WordInPlay;
            placeMoveDto.TilesInRack = TilesInRack;
            var response = await Http.PostAsJsonAsync<PlaceMoveDto>($"/api/PlaceMove/{GameId}", placeMoveDto);
            IsSubmitting = false;
            MyMove = true;

            if (response.StatusCode == System.Net.HttpStatusCode.UnprocessableEntity)
            {
                // Invalid move was presented
                // This case should only be possible with no local word check.
                MessageForLocalHuman = await response.Content.ReadAsStringAsync();
                await PlaySound("Negative2.mp3");
                return;

            }
            else if (!response.IsSuccessStatusCode)
            {
                MessageForLocalHuman = $"Unable to make move, code: {response.StatusCode.ToString()}";
                await PlaySound("Negative2.mp3");
                return;
            }
            var gameDto = await response.Content.ReadFromJsonAsync<GameDto>();

            await ApplyDownloadToGui(currentGame, gameDto);

            MessageForLocalHuman = ""; // Suppress text detail since it's highlighted on tiles (keep cleaner display)
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Unable to make move: {ex}");
            MessageForLocalHuman = $"Unable to make move: {ex.Message}";
            return;

        }
        IsSubmitting = false;

        StateHasChanged();

        Console.WriteLine($"Played {nPlayed}, have {TilesInRack.Count} tiles");
    }

    private GameDto CloneGameDto(GameDto original)
    {
        string json = JsonConvert.SerializeObject(original, new JsonSerializerSettings
        {
            ReferenceLoopHandling = ReferenceLoopHandling.Ignore // Handle circular references
        });
        return JsonConvert.DeserializeObject<GameDto>(json);
    }

    private async Task ShowProfessorAdvisor()
    {
        // this feature is great but potentially problematic. it's possible that while you are admiring the suggestions
        // of the owl that an opponent will make a move which is updated on your screen
        // so when this saved game is re-instated it wipes out the opponent move
        // what to do ?
        // scenario is evident if saveGameStateDto is not null and we receive a ClientReceiveMove event
        // in this case invalidate the saveGameStateDto (set to null) and then use this fact in this block of
        // code to rebuild the game from the latest server side copy of the state
        saveGameStateDto = new GameStateDto(currentGame);

        professorMessage = "Thinking ...";
        showProfessorDialog = true;
        if (!professorMoveValid)
        {
            StateHasChanged();
            await Task.Delay(TimeSpan.FromMilliseconds(100));  // Update UI

            //Stopwatch stopwatch = Stopwatch.StartNew();
            var moveSuggestion = new ComputerMoveSuggestion();
            await moveSuggestion.MakeComputerMoveAsync(currentMoveGameDto, myEmail);
            //stopwatch.Stop();
            //Console.WriteLine($"\nTime taken for move: {stopwatch.ElapsedMilliseconds} ms");
        }
        professorMoveValid = true;

        var humanPlayer = FindSelf(currentGame);
        var humanScore = humanPlayer.LastMoveScore;

        var displayComputerBoard = false;
        professorMessage = GetProfessorMessage(humanScore, currentMoveGameDto.GameState_Dto.CurrentMoveScore, ref displayComputerBoard);

        if (displayComputerBoard)
        {
            initialLoad = true;
            await ApplyDownloadToGui(currentGame, currentMoveGameDto);
        }

        StateHasChanged();
        while (showProfessorDialog)
        {
            await Task.Delay(TimeSpan.FromMilliseconds(200));
        }

        // owl flown - check if game has been updated
        bool theGameChanged = false;
        if (saveGameStateDto == null)
        {
            // yipes - game has been updated while we looked to the owl for wisdom
            // need to get things in order
            //Console.WriteLine("The game has changed Holmes");
            theGameChanged = true;

            // jiggery pokery to prevent ApplyDownloadFromGui which is called by BuildGame
            // doing stuff to the rack and board tiles
            // it's a nasty hack really
            // ie make saveGameStateDto not NULL before call to BuildGame
            saveGameStateDto = new GameStateDto();

            await BuildGame();

            // update the saveGameStateDto...
            // ...so the next pre-existing if block of code behaves as it always did
            saveGameStateDto = new GameStateDto(currentGame);
        }

        if (displayComputerBoard || theGameChanged)
        {
            var restoreGameDto = new GameDto();
            restoreGameDto.GameId = GameId;
            restoreGameDto.GameState_Dto = saveGameStateDto;
            restoreGameDto.HighestChatSeen = highestChatSeen;
            restoreGameDto.Chat_Dto = new List<ChatDto>();  // Empty for update - will be overwritten

            saveGameStateDto = null;

            initialLoad = true;
            //Console.WriteLine("I can see (the game) clearly now the owl is gone");
            await ApplyDownloadToGui(currentGame, restoreGameDto);
        }

        saveGameStateDto = null;
        showProfessorDialog = false;
        StateHasChanged();
    }

