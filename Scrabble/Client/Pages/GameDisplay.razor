@page "/game/{gameId:int}"

@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))

@using System.Linq
@using System.Text
@using Scrabble.Core
@using Scrabble.Core.Config
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Scrabble.Client.Components
@using System.Runtime.InteropServices.JavaScript
@using Scrabble.Shared
@using Scrabble.Client.Data
@using Newtonsoft.Json;
@using System.Diagnostics;

@attribute [Authorize(Policy = Policies.IsPlayer)]

@inject HttpClient Http
@inject IModalService Modal
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime;


@if (IsSubmitting)
{
    <div class="overlay">
        <div class="overlay-content">
            <h4>Submitting...</h4>
        </div>
    </div>
}

@if (Game.Instance == null || currentGame == null)
{
    <h1>@LoadMessage</h1>
}
else
{
    <div class="container-fluid">
        <div class="row mb-3 d-flex flex-nowrap"> <!-- removed "overflow-scroll" -->
            <!-- Player total scores on the left, current player at the top, next player below -->
            <div id="total-scores" class="col-auto pt-4">
                <!-- 10rem => 160px -->
                <!-- 12rem => 192px -->
                <!-- 15rem => 240px -->
                <!-- @{string score_card_style_options = "width: 10rem; max-width: 12rem";} -->
                @{string score_card_style_options = "min-width: 10rem; max-width: 12rem";}
                @{string TotalMoveDuration = "";}
                @if (currentGame.FinalGameStatus == null)
                {
                    <!-- the game is still in progress -->
                    int j = 0; int opacity = 100;
                    <!-- If I am the current player, add a border decoration to prompt me -->
                    string border_decoration_your_go = "border border-3 border-danger rounded-3";
                    @if (!MyMove)
                    {
                        border_decoration_your_go = "";
                    }
                    <!-- Display the current player at the top with a blue background -->
                    @for (int i = 0; i < currentGame.players.Count; i++)
                    {
                        @if (currentGame.players[i].MyTurn)
                        {
                            TotalMoveDuration = PrintTimeSpan(currentGame.players[i].TotalMoveDuration);
                            j = i;
                            <div class=@($"card mb-2 text-white bg-info {border_decoration_your_go}") style=@($"{score_card_style_options}")>
                                <h5 class="card-header">@currentGame.players[i].Name</h5>
                                <h4 class="card-body" style="text-align: right; font-weight: bold;">@currentGame.players[i].Score</h4>
                                <div class="card-footer" style="text-align: right; font-style: italic;">@TotalMoveDuration</div>
                            </div>
                        }
                    }
                    string border_decoration_track_me = "";
                    <!-- Display the other players below with decreasing opacity -->
                    @for (int i = 0; i < currentGame.players.Count - 1; i++)
                    {
                        j = (j + 1) % currentGame.players.Count;
                        TotalMoveDuration = PrintTimeSpan(currentGame.players[j].TotalMoveDuration);
                        @if (currentGame.players[j].Name == myName)
                        {
                            border_decoration_track_me = "border border-2 border-warning rounded-3";
                        }
                        else
                        {
                            border_decoration_track_me = "";
                        }
                        @if (currentGame.players[j].IsActive)
                        {
                            opacity -= 25;
                            <div class=@($"card mb-2 text-black bg-secondary bg-opacity-{opacity} {border_decoration_track_me}") style=@($"{score_card_style_options}")>
                                <h6 class="card-header">@currentGame.players[j].Name</h6>
                                <h5 class="card-body" style="text-align: right;">@currentGame.players[j].Score</h5>
                                <div class="card-footer" style="text-align: right; font-style: italic;">@TotalMoveDuration</div>
                            </div>
                        }
                    }
                    <!-- Lastly display the inactive players in red -->
                    @for (int i = 0; i < currentGame.players.Count - 1; i++)
                    {
                        TotalMoveDuration = PrintTimeSpan(currentGame.players[i].TotalMoveDuration);
                        @if (!currentGame.players[i].IsActive)
                        {
                            <div class="card mb-2 text-white bg-danger" style=@($"{score_card_style_options}")>
                                <h6 class="card-header">@currentGame.players[i].Name</h6>
                                <h6 class="card-body" style="text-align: right;">Resigned</h6>
                                <div class="card-footer" style="text-align: right; font-style: italic;">@TotalMoveDuration</div>
                            </div>
                        }
                    }
                }
                else
                {
                    <!-- game is over -->
                    <!-- update the player score cards because the recent moves -->
                    <!-- may not be being displayed -->
                    <!-- put the winner at the top of the list -->
                    @if (currentGame.FinalGameStatus.Win_Type == WinTypes.WinType.Win)
                    {
                        int shown_counter = 0;
                        bool winner_shown = false;
                        int i = 0;
                        @while (shown_counter < currentGame.players.Count)
                        {
                            TotalMoveDuration = PrintTimeSpan(currentGame.players[i].TotalMoveDuration);
                            if (currentGame.players[i].Name == currentGame.FinalGameStatus.WinningPlayerName && !winner_shown)
                            {
                                winner_shown = true;
                                shown_counter++;
                                <div class="card mb-2 text-white bg-success" style=@($"{score_card_style_options}")>
                                    <h5 class="card-header">@currentGame.players[i].Name</h5>
                                    <h4 class="card-body" style="text-align: right; font-weight: bold;">@currentGame.players[i].Score</h4>
                                    <div class="card-footer" style="text-align: right; font-style: italic;">@TotalMoveDuration</div>
                                </div>
                            }
                            i = (i + 1) % currentGame.players.Count;
                            TotalMoveDuration = PrintTimeSpan(currentGame.players[i].TotalMoveDuration);
                            if (winner_shown)
                            {
                                shown_counter++;
                                <div class="card mb-2 text-white bg-danger" style=@($"{score_card_style_options}")>
                                    <h6 class="card-header">@currentGame.players[i].Name</h6>
                                    <h6 class="card-body" style="text-align: right;">@currentGame.players[i].Score</h6>
                                    <div class="card-footer" style="text-align: right; font-style: italic;">@TotalMoveDuration</div>
                                </div>
                            }
                        }
                    }
                    else
                    {
                        <!-- a draw -->
                        @for (int i = 0; i < currentGame.players.Count; i++)
                        {
                            TotalMoveDuration = PrintTimeSpan(currentGame.players[i].TotalMoveDuration);
                            <div class="card mb-2 text-white bg-primary" style=@($"{score_card_style_options}")>
                                <h6 class="card-header">@currentGame.players[i].Name</h6>
                                <h6 class="card-body" style="text-align: right;">@currentGame.players[i].Score</h6>
                                <div class="card-footer" style="text-align: right; font-style: italic;">@TotalMoveDuration</div>
                            </div>
                        }
                    }
                }
            </div>

            <!-- Game board in the middle -->
            <!-- pb-4 means that when the recent moves column is displaced to the next row -->
            <!-- that there is decent separation between it and the action buttons -->
            <div id="game-board" class="col-auto pb-4 game-board-container d-flex flex-nowrap">
                @if (!String.IsNullOrEmpty(MessageForLocalHuman))
                {
                    <div class="scoreboard" id="scoreboard">@MessageForLocalHuman</div>
                }
                else
                {
                    <div>&nbsp;</div>
                }
                <div id="game" class="game">
                    <div class="game-element-container">
                        <div class="game-board">
                            @for (int y = 0; y < ScrabbleConfig.BoardLength; y++)
                            {
                                @for (int x = 0; x < ScrabbleConfig.BoardLength; x++)
                                {
                                    var square = Game.Instance.PlayingBoard.Get(x, y);
                                    <Scrabble.Client.Components.UISquare SquareContainer="square" />
                                }
                            }
                        </div>
                    </div>
                </div>

                <!-- The owl, player tile rack and tile bag -->
                <div id="game-play-row" class="game-play-container">
                    <div>
                        @{string owl_is = "invisible";}
                        @if (!MyMove && currentMoveGameDto != null && AllowTheOwl() && !showProfessorDialog)
                        {
                            owl_is = "visible";
                        }
                        <div class=@($"{owl_is}")>
                            <button class="professor-owl" @onclick=ShowProfessorAdvisor/>
                        </div>
                    </div>

                    <div class="player-tiles">
                        @if (showProfessorDialog)
                        {
                            <div class="professor-dialog-new">
                                <table>
                                    <tr>
                                        <td rowspan="2">
                                            <img src="/images/ProfessorOwl2.png" class="professor-icon"/>
                                        </td>
                                        <td class="text-center">
                                            @professorMessage <br/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>

                                        </td>
                                        <td class="text-center">
                                            <button @onclick=ProfessorDialogOk>OK</button>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        }
                        else
                        {
                            <button @onclick=Shuffle disabled="@DisabledShuffle()">Shuffle</button>
                            @for (int i = 0; i < TilesInRack.Count; i++)
                            {
                                var index = i;
                                <UITile_2 @key="TilesInRack[index].ID" TilePiece="TilesInRack[index]"></UITile_2>
                            }

                            <!-- <div class="tile-bag-area"> -->
                                <div class="tile-bag">
                                    @currentGame.TileBag.Inventory.Count
                                </div>
                            <!-- </div> -->
                        }
                    </div>
                </div>

                <!-- Action buttons -->
                <div id="action-buttons-row" class="action-buttons-container">
                    @if (!showProfessorDialog)
                    {
                        <div class="action-buttons-container">
                            @if (!MyMove && MyGamesList.NextUnplayedGameId() > 0)
                            {
                                <button class="next-game-nudge" @onclick=NextUnplayedGame>Next Game</button>
                            }

                            @if (currentGame.FinalGameStatus == null)
                            {
                                @if (IsSwapping)
                                {
                                    <span>(Exchange): Select tiles </span>
                                    <button @onclick=StopSwap>Cancel</button>
                                    <button @onclick=DoSwap disabled="@Disabled(SwappingTiles.Count == 0 || (SwappingTiles.Count > currentGame.TileBag.Inventory.Count))">Swap</button>
                                }
                                else
                                {
                                    if (WordInPlay.Count == 0)
                                    {
                                        <button @onclick=Pass disabled="@Disabled(!MyMove)">Pass</button>
                                        <button @onclick=StartSwap disabled="@Disabled(!MyMove || !CanSwap)">Exchange</button>
                                    }
                                    else
                                    {
                                        <button @onclick=Play disabled="@Disabled(WordInPlay.Count==0 || !validMove)">Play</button>
                                        <button @onclick=Recall disabled="@Disabled(WordInPlay.Count==0)">Recall</button>
                                    }
                                    <button @onclick=Resign disabled="@Disabled()">Resign</button>
                                }
                            }
                            else
                            {
                                <button @onclick=Rematch>Rematch</button>
                            }

                            <!-- don't get distracted if you are swapping tiles -->
                            @if (!IsSwapping)
                            {
                                <button class="@ChatAlert()" @onclick=ShowChat>Chat</button>
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- Recent moves and scores on the right -->
            <!-- it is not displayed on insufficiently wide screens -->
            <!-- for now have removed this from the class 'd-none d-xxl-block' because the .js -->
            <!-- has been jazzed up a bit to improve behaviour when resizing the browser window -->
            <div id="recent-moves" class="col-auto pt-4">
                <!-- 15rem => 240px -->
                <!-- 20rem => 320px -->
                <!-- @{string moves_card_style_options = "width: 15rem; max-width: 20rem";} -->
                @{string moves_card_style_options = "min-width: 14rem; max-width: 16rem";}
                @{string LastMoveDuration = "";}
                @for (int i = currentGame.ListOfRecentMoves.Count - 1; i >= 0; i--)
                {
                    <!-- if 'Action' is "starts", "played", "resigned", "passed", "swapped" or "won"
                    then 'Who' will contain a name
                    if 'Action' contains "drawn" then 'Who' will be unpopulated -->
                    string action = currentGame.ListOfRecentMoves[i].Action;
                    string who = currentGame.ListOfRecentMoves[i].Who;
                    LastMoveDuration = PrintTimeSpan(currentGame.ListOfRecentMoves[i].MoveDuration);
                    @if (action == "played")
                    {
                        <div class="card mb-1 text-black bg-primary bg-opacity-50" style=@($"{moves_card_style_options}")>
                            <h6 class="card-header">@who played...</h6>
                            <div class="card-body">@currentGame.ListOfRecentMoves[i].Words</div>
                            <div class="card-footer d-flex justify-content-between">
                                <div>@LastMoveDuration</div>
                                <div style="font-weight: bold; font-style: italic;">Score : @currentGame.ListOfRecentMoves[i].Score</div>
                            </div>
                        </div>
                    }
                    else if (action == "starts")
                    {
                        <div class="card mb-1 text-black bg-warning" style=@($"{moves_card_style_options}")>
                            <h6 class="card-header">@who</h6>
                            <div class="card-body">Starts the game</div>
                        </div>
                    }
                    else if (action == "won")
                    {
                        <div class="card mb-1 text-white bg-success" style=@($"{moves_card_style_options}")>
                            <h6 class="card-header">@who</h6>
                            <div class="card-body">Won the game</div>
                        </div>
                    }
                    else if (action == "passed")
                    {
                        <div class="card mb-1 text-black bg-warning" style=@($"{moves_card_style_options}")>
                            <h6 class="card-header">@who</h6>
                            <div class="card-body">Passed</div>
                        </div>
                    }
                    else if (action == "swapped")
                    {
                        <div class="card mb-1 text-black bg-warning" style=@($"{moves_card_style_options}")>
                            <h6 class="card-header">@who</h6>
                            <div class="card-body">Swapped tiles</div>
                        </div>
                    }
                    else if (action == "resigned")
                    {
                        <div class="card mb-1 text-white bg-danger" style=@($"{moves_card_style_options}")>
                            <h6 class="card-header">@who</h6>
                            <div class="card-body">Resigned</div>
                        </div>
                    }
                    else if (action == "drawn")
                    {
                        <div class="card mb-1 text-white bg-secondary" style=@($"{moves_card_style_options}")>
                            <div class="card-body">Match drawn</div>
                        </div>
                    }
                    else
                    {
                        <div class="card mb-1 text-white bg-dark" style=@($"{moves_card_style_options}")>
                            <div class="card-body">! Unknown action !</div>
                        </div>
                    }
                }
            </div>
        </div>

        <audio @key="@(audioId)" src="@soundUrl" type="audio/mp3" autoplay>
            Your browser does not support the html audio tag.
        </audio>
    </div>
}

@code {

    private string soundUrl { get; set; }
    private Guid audioId = Guid.NewGuid();

    private IJSObjectReference _jsModule;
    private static GameDisplay gameDisplayReference;

    [Parameter] public int GameId { get; set; }

    public List<Square> GameBoardSquares;  // Linear Game board grid elements

    public List<Tile> TilesInRack;
    public List<UITile> UITilesInRack = new List<UITile>();

    private List<TileInPlay> WordInPlay = new List<TileInPlay>();

    private const string JS_SetTileForDrop = "SetTileForDrop";
    private const string JS_RmEventListenerForIdList = "RmEventListenerForIdList";

    private bool IsSwapping = false;
    private bool CanSwap => !currentGame.TileBag.IsEmpty;
    private bool MyMove { get; set; }

    private bool validMove { get; set; }

    private string MessageForLocalHuman { get; set; }
    private string LoadMessage { get; set; } = "Loading game...";

    private GameDto currentMoveGameDto = null; // For advisory move: State at start of move
    // For use when owl is invoked: set at start of move to save current state to be restored once
    // owl has been dismissed. made "global" so if another user move comes in then it can be flagged
    // as invalidating the saved game state
    private GameStateDto saveGameStateDto = null;

    private bool professorMoveValid = false;
    private bool showProfessorDialog = false;
    private string professorMessage = "";

    int highestChatSeen = 0;

    private List<Tile> SwappingTiles = new List<Tile>();

    private bool Disabled(bool buttonDisabled = false) => buttonDisabled || IsSubmitting || !MyMove;
    private bool DisabledShuffle(bool buttonDisabled = false) => buttonDisabled || IsSubmitting || (currentGame.FinalGameStatus != null);
    private bool initialLoad = true;

    private bool AllowTheOwl() => currentGame.AllowOwl;

    private HubConnection hubConnection;
    private Data.ChatParameters chatParameters;

    private GameState currentGame;

    // store all the Javascript actions you want to run **once** after rendering
    private List<(string command, string parameter)> actionsToRunAfterRender = new List<(string command, string parameter)>();

    // Get access to claims
    [CascadingParameter] private Task<AuthenticationState> authenticationStateTask { get; set; }
    private string myEmail;
    private string myName;
    private int lastMoveCountProcessed;

    private IDisposable LocationChangingHandler;

    public async Task PlaySound(string filename)
    {
        var player = AuthCache.CachedPlayer;
        if (player.EnableSound)
        {
            // --This direct audio element play fails when the browser invokes with the range: header
            // --and the web server fails on all with with error code 416
            // audioId = Guid.NewGuid(); // reload the player
            var soundPath = $"/sounds/{filename}";
            //soundUrl = soundPath;
            // InvokeAsync(StateHasChanged);

            await _jsModule.InvokeVoidAsync("playSound", soundPath);
        }
    }

    private async ValueTask OnLocationChanging(LocationChangingContext context)
    {
        // you can use the following call to prevent the navigation :    context.PreventNavigation();
        var target = context.TargetLocation;

        Console.WriteLine(" ");
        Console.WriteLine($"OnLocationChanging(): Current Game ID={GameId}");
        Console.WriteLine($"[GameDisplay] Navigating to : {target}");

        // clean up any DnD related event handlers
        // these two lines of code moved here from the places in the main body
        // where NavigateTo was called
        // from 1.NextUnplayedMatch button
        //      2.Rematch button
        //      3.An incoming request for a rematch (in this case the initialLoad flag was NOT being updated)
        await _jsModule.InvokeVoidAsync("CleanupDragAndDrop", null);

        // not sure this next one is needed because when we navigate to a game the OnParametersSetAsync()
        // method will set it to true anyway
        //initialLoad = true;

        // clean up any active hub connections before we go
        if (hubConnection != null)
        {
            if (target.Contains("/game/"))
            {
                // Navigated to new game id from within existing game; log new game into hub
                // this next ReceiveGameLogin call is done in OnParametersSetAsync()
                // so comment out and just print a blank line until am happy this part of
                // the if block can be taken out
                //await hubConnection.InvokeAsync("ReceiveGameLogin", GameId);
                Console.WriteLine(" ");
            }
            else
            {
                // navigating somewhere else e.g. two letter words or the game list etc
                try { await hubConnection.StopAsync(); }
                catch (Exception exception) { Console.WriteLine(exception.Message); }
                finally { await hubConnection.DisposeAsync(); }

                Console.WriteLine("*** GameState: Removed hub connection.");
                hubConnection = null;

                // handler not needed anymore
                Console.WriteLine("Deregister the LocationChanging Handler");
                LocationChangingHandler.Dispose();
            }
        }
    }

    /// <summary>
    /// Notify server which game we're playing
    /// </summary>
    /// <returns></returns>
    private async Task SetGameIdAsync()
    {
        Console.WriteLine($"SetGameIdAsync(): Game ID={GameId}");
        await hubConnection.InvokeAsync("ReceiveGameLogin", GameId);
    }

    protected override async Task OnInitializedAsync()
    {
        Console.WriteLine(" ");
        Console.WriteLine("OnInitializedAsync()");

        await SetupHub();
        await hubConnection.StartAsync();

        Console.WriteLine("Hub ConnectionId : '" + hubConnection.ConnectionId + "'");

        Console.WriteLine("Register a LocationChanging Handler");
        LocationChangingHandler = NavigationManager.RegisterLocationChangingHandler(OnLocationChanging);

        _jsModule = await JSRuntime.InvokeAsync<IJSObjectReference>("import", @Assets["./scripts/DragAndDrop.js"]);
    }

    protected override async Task OnParametersSetAsync()
    {
        Console.WriteLine(" ");
        Console.WriteLine($"OnParametersSetAsync(): Game ID={GameId}");

        await SetGameIdAsync();

        var authState = await authenticationStateTask;
        var user = authState.User;

        myEmail = user.Claims.Where(x => x.Type == AppEmailClaimType.ThisAppEmailClaimType).Select(x => x.Value).FirstOrDefault();
        Console.WriteLine($"myEmail={myEmail}");

        MessageForLocalHuman = "New game";
        gameDisplayReference = this;

        initialLoad = true;
        myName = "";
        lastMoveCountProcessed = -1;

        await LoadGameAsync();

        myName = FindSelf(currentGame).Name;
        lastMoveCountProcessed = currentGame.MoveCount - 1;
        Console.WriteLine($"myName={myName}");
        Console.WriteLine("lastMoveCountProcessed = " + lastMoveCountProcessed);  // initialization 

        await _jsModule.InvokeVoidAsync("InitializeDragAndDrop");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // run all the actions (.NET code) **once** after rendering

        var localActions = new List<(string command, string parameter)>();
        localActions.AddRange(actionsToRunAfterRender);
        actionsToRunAfterRender.Clear();

        foreach (var jsAction in localActions)
        {
            await _jsModule.InvokeVoidAsync(jsAction.command, jsAction.parameter);
        }
        // clear the actions to make sure the actions only run **once**
        //actionsToRunAfterRender.Clear();
        await base.OnAfterRenderAsync(firstRender);
    }


    private async Task LoadGameAsync()
    {
        try
        {
            await BuildGame();
        }
        catch (Exception ex)
        {
            LoadMessage = $"Problem loading game: {ex.Message}";
            Console.WriteLine(ex.ToString());
            return;
        }
    }

    private async Task<GameDto> DownloadGameDto(int gid)
    {
        try
        {
            return await Http.GetFromJsonAsync<GameDto>($"/api/Game/{gid}");
        }
        catch (Exception ex)
        {
            LoadMessage = $"Problem downloading GameDto for game id {gid}, ({ex.Message})";
            Console.WriteLine(ex.ToString());
            return null;
        }
    }

    private async Task BuildGame()
    {
        GameState newGame = null;
        if (GameId > 0)
        {
            var gameDto = await Http.GetFromJsonAsync<GameDto>($"/api/Game/{GameId}");
            newGame = new GameState(new List<Player>(), Data.WordLookupSingleton.Instance);

            await ApplyDownloadToGui(newGame, gameDto);

            if (MyMove)
            {
                currentMoveGameDto = CloneGameDto(gameDto);
            } else
            {
                currentMoveGameDto = null;
            }
            professorMoveValid = false;
        }
        else
        {
            // Local standalone setup (no longer works properly)
            Scrabble.Core.Setup.SetupGameState(Data.WordLookupSingleton.Instance);
            newGame = Game.Instance;
            Setup.SetupComputer(newGame);
            TilesInRack = newGame.InteractivePlayer.Tiles;
            Game.Instance.Start(0);
            MyMove = true;
        }
        Game.Instance = newGame;
        currentGame = newGame;
    }

    public static void HandleSingleClickOnTile(string tileId)
    {
        gameDisplayReference.SelectForSwapping(tileId);
    }

    private void SelectForSwapping(string tileId)
    {
        if (!IsSwapping) return;
        var rackIndex = FindTileIndexInRack(tileId);
        if (rackIndex < 0) return;

        var tile = TilesInRack[rackIndex];
        tile.SelectedForSwap = !tile.SelectedForSwap;   // Toggle X overlay
        if (tile.SelectedForSwap)
        {
            if (SwappingTiles.Count >= currentGame.TileBag.Inventory.Count) return; // alert tone?
            SwappingTiles.Add(tile);
        }
        else
        {
            SwappingTiles.Remove(tile);
        }
        StateHasChanged();
    }

    public static void HandleDoubleClickOnTile(string tileId)
    {
        gameDisplayReference.SendTileToRack(tileId);
    }

    private void SendTileToRack(string tileId)
    {
        var wordInPlayIndex = FindTileIndexInWordInPlay(tileId);
        if (wordInPlayIndex >= 0)
        {
            var tileInPlay = WordInPlay[wordInPlayIndex];
            if (tileInPlay.Tile.Score == 0) tileInPlay.Tile.SetBlankLetter(' ');
            tileInPlay.Tile.TileInRack = true;
            var fromSquare = currentGame.PlayingBoard.Get(tileInPlay.BoardPosition);
            WordInPlay.RemoveAt(wordInPlayIndex);
            fromSquare.Tile = null;
            TilesInRack.Add(tileInPlay.Tile);
            //Console.WriteLine("Double click on board tile to send back to rack");
            actionsToRunAfterRender.Add((JS_SetTileForDrop, tileId));  // Re-enable for dropped tile
            EvaluateMove();
            StateHasChanged();
        }
    }


    /// <summary>
    /// Called from Javascript after object drop
    /// </summary>
    /// <param name="dragId"> 'id' attribute of dragged object
    /// <param name="dropId"> 'id' attribute of object dropped into
    /// <returns></returns>
    [JSInvokable("HandleDropAsync")]
    public static async Task HandleDropAsync(string dragId, string dropId)
    {
        //Console.WriteLine($"DotNet(HandleDropAsync) : Drop {dragId} onto {dropId}");
        if (gameDisplayReference.IsSwapping) return;

        var handled = false;
        if (dragId.StartsWith("Tile") && dropId.StartsWith("Tile"))
        {
            await gameDisplayReference.HandleDropTileOnTile(dragId, dropId);
            handled = true;
        }
        else if (dragId.StartsWith("Tile") && dropId.StartsWith("Square"))
        {
            await gameDisplayReference.HandleDropTileOnSquare(dragId, dropId);
            handled = true;
        }

        if (!handled)
        {
            Console.WriteLine($"RZR Unhandled drop: '{dragId}' onto '{dropId}'");
        }

        gameDisplayReference.EvaluateMove();

        // WHY ?? what's the difference between calls to InvokeAsync(StateHasChanged),
        // StateHasChanged() and the next line ?
        await gameDisplayReference.InvokeAsync(gameDisplayReference.StateHasChanged);

        //return Task.CompletedTask;
    }

    /// <summary>
    /// Drop tile onto square; square will be empty because tiles are given a drop priority
    /// </summary>
    /// <param name="dragId">
    /// <param name="dropId">
    private async Task HandleDropTileOnSquare(string dragId, string dropId)
    {
        if (!MyMove)
        {
            //Console.WriteLine("Tile drop ignored - Not my turn");
            return; // Disallow board moves while awaiting partner move
        }

        var sourceRackIndex = FindTileIndexInRack(dragId); // If starting from rack
        var squareInfo = FindSquareInfo(dropId);
        if (squareInfo == null)
        {
            Console.WriteLine($"HandleDropTileOnSquare : Unable to find square info for dragId: {dragId}, dropId: {dropId}");
            //actionsToRunAfterRender.Add((JS_SetTileForDrop, dragId));  // Re-enable for dropped tile
            return;
        }

        var targetSquare = currentGame.PlayingBoard.Get(squareInfo.Value.row, squareInfo.Value.col);

        if (sourceRackIndex >= 0)
        {
            // Dragging from Rack to board
            var moveTile = TilesInRack[sourceRackIndex];
            moveTile.TileInRack = true;
            if (moveTile.Score == 0)
            {
                // Assign letter to blank tile
                var newLetter = await GetBlankTileLetter();
                if (newLetter == '#') return; // User cancelled
                moveTile.SetBlankLetter(char.ToUpper(newLetter));
            }

            targetSquare.Tile = moveTile;
            TilesInRack.RemoveAt(sourceRackIndex);
            moveTile.TileInRack = false;
            moveTile.PinnedOnBoard = false;
            WordInPlay.Add(new TileInPlay(targetSquare.BoardPosition, moveTile));

            //Console.WriteLine("From rack to empty board square");
            actionsToRunAfterRender.Add((JS_SetTileForDrop, dragId));  // Re-enable for dropped tile
        }
        else
        {
            var wordInPlayIndex = FindTileIndexInWordInPlay(dragId);
            if (wordInPlayIndex >= 0)
            {
                // Dragging from one square to another empty square
                var tileInPlay = WordInPlay[wordInPlayIndex];
                var leavingSquare = currentGame.PlayingBoard.Get(tileInPlay.BoardPosition);
                leavingSquare.Tile = null;
                
                // something that looks mighty similar to this is called after this  method
                // returns to caller. of course it could be something totally different coz i no
                // little about blazor/dotnet/c# 
                // anyhoo . commented it out for now to see if it breaks anything
                // WHY ?? await InvokeAsync(StateHasChanged); // Notify of removed tile

                targetSquare.Tile = tileInPlay.Tile;
                tileInPlay.BoardPosition = targetSquare.BoardPosition;   // Update board position for WordInPlay

                //Console.WriteLine("From board square to empty board square");
                actionsToRunAfterRender.Add((JS_SetTileForDrop, dragId));  // Re-enable for dropped tile
            }
        }
    }

    private (int row, int col)? FindSquareInfo(string squareId)
    {
        var squareDetail = squareId.Split(',');
        if (squareDetail.Length < 3) return null;
        int row = 0;
        if (!Int32.TryParse(squareDetail[1], out row)) return null;
        int col = 0;
        if (!Int32.TryParse(squareDetail[2], out col)) return null;

        if (row > ScrabbleConfig.BoardLength || col > ScrabbleConfig.BoardLength) return null;

        return (row, col);
    }


    /// <summary>
    /// Drop tile onto tile: might be to reorder player's tile rack or to replace a letter on board in play
    /// </summary>
    /// <param name="dragId">
    /// <param name="dropId">
    private async Task HandleDropTileOnTile(string dragId, string dropId)
    {
        // bail out early if drag and drop id values are the same...
        if (dragId == dropId)
        {
            actionsToRunAfterRender.Add((JS_SetTileForDrop, dragId));  // Re-enable for dragged tile
            Console.WriteLine("RZR dragId == dropId [" + dragId + "]");
            return;
        }

        var sourceRackIndex = FindTileIndexInRack(dragId);
        var targetRackIndex = FindTileIndexInRack(dropId);
        if (sourceRackIndex >= 0 && targetRackIndex >= 0)
        {
            // Reorder tiles in tile rack
            //Console.WriteLine("Reordering tiles in the rack");
            var moveTile = TilesInRack[sourceRackIndex];
            TilesInRack.RemoveAt(sourceRackIndex);
            TilesInRack.Insert(targetRackIndex, moveTile);
        }
        else if (sourceRackIndex >= 0)
        {
            // Dropping from rack on another tile on the board
            var wordInPlayIndex = FindTileIndexInWordInPlay(dropId);
            if (wordInPlayIndex >= 0)
            {
                var tileToPlace = TilesInRack[sourceRackIndex];
                if (tileToPlace.Score == 0)
                {
                    // Assign letter to blank tile before drop
                    var newLetter = await GetBlankTileLetter();
                    if (newLetter == '#') return; // User cancelled
                    tileToPlace.SetBlankLetter(char.ToUpper(newLetter));
                }


                var tileInPlay = WordInPlay[wordInPlayIndex];
                tileInPlay.Tile.TileInRack = true;
                if (tileInPlay.Tile.Score == 0) tileInPlay.Tile.SetBlankLetter(' ');
                var square = currentGame.PlayingBoard.Get(tileInPlay.BoardPosition);
                TilesInRack.RemoveAt(sourceRackIndex);

                // Return tile from play to player rack
                var tileToRemove = tileInPlay.Tile;
                WordInPlay.RemoveAt(wordInPlayIndex);
                TilesInRack.Add(tileToRemove);
                tileToRemove.TileInRack = true;
                square.Tile = null;

                //again, WHY ?? is it because of the JS_SetTileForDrop further down
                // and has to be run first ?
                //await InvokeAsync(StateHasChanged); // Notify of removed tile

                // Place tile on board
                square.Tile = tileToPlace;
                tileToPlace.TileInRack = false;
                WordInPlay.Add(new TileInPlay(square.BoardPosition, tileToPlace));
                //Console.WriteLine("From rack to tile already on the board");
                actionsToRunAfterRender.Add((JS_SetTileForDrop, dragId));  // Re-enable for dragged tile
                actionsToRunAfterRender.Add((JS_SetTileForDrop, dropId));  // Re-enable for tile sent to rack
            }
            else
            {
                // Tile was already played
            }

        }
        else
        {
            // Check for dragging from one board square to drop onto another tile board square
            var wordInPlayDragIndex = FindTileIndexInWordInPlay(dragId);
            var wordInPlayDropIndex = FindTileIndexInWordInPlay(dropId);
            if (wordInPlayDragIndex >= 0 && wordInPlayDropIndex >= 0 &&
                dragId != dropId)       // saw case where when tile dropped back on itself it created the "double tile" scenario
            {
                // eligible for drop in place of drop target tile
                var dragTileInPlay = WordInPlay[wordInPlayDragIndex];
                var dropTileInPlay = WordInPlay[wordInPlayDropIndex];
                var fromSquare = currentGame.PlayingBoard.Get(dragTileInPlay.BoardPosition);
                var toSquare = currentGame.PlayingBoard.Get(dropTileInPlay.BoardPosition);
                var tileToMove = dragTileInPlay.Tile;

                // Return tile from play to player rack
                var tileToRemove = dropTileInPlay.Tile;
                if (tileToRemove.Score == 0) tileToRemove.SetBlankLetter(' ');
                tileToRemove.TileInRack = true;
                WordInPlay.RemoveAt(wordInPlayDropIndex);
                TilesInRack.Add(tileToRemove);
                fromSquare.Tile = null;

                // WHY ?? await InvokeAsync(StateHasChanged); // Notify of removed tile

                // Place tile on board
                toSquare.Tile = tileToMove;
                dragTileInPlay.BoardPosition = dropTileInPlay.BoardPosition;  // Update board position for WordInPlay
                //Console.WriteLine("From tile on board to another tile on board");
                actionsToRunAfterRender.Add((JS_SetTileForDrop, dragId));  // Re-enable for dropped tile
                actionsToRunAfterRender.Add((JS_SetTileForDrop, dropId));  // Re-enable for tile in rack
            }
        }
    }

    /// <summary>
    /// Check if tile ID in player rack
    /// </summary>
    /// <param name="tileId">
    /// <returns>Index into list, -1 if not found</returns>
    private int FindTileIndexInRack(string tileId)
    {
        var foundIndex = -1;
        for (int i = 0; i < TilesInRack.Count; i++)
        {
            if (TilesInRack[i].ID == tileId)
            {
                return i;
            }
        }
        return foundIndex;
    }

    /// <summary>
    /// Check if tile ID in play
    /// </summary>
    /// <param name="tileId">
    /// <returns>Index into list, -1 if not found</returns>
    private int FindTileIndexInWordInPlay(string tileId)
    {
        var foundIndex = -1;
        for (int i = 0; i < WordInPlay.Count; i++)
        {
            if (WordInPlay[i].Tile.ID == tileId)
            {
                return i;
            }
        }
        return foundIndex;
    }


