    private async Task ApplyDownloadToGui(GameState newGame, GameDto gameDto)
    {
        UpdateGameStateFromDto.UpdateGameState(newGame, gameDto.GameState_Dto);
        if (lastMoveCountProcessed > -1)
        {
            Console.WriteLine(" ");
            Console.WriteLine("Last MoveCount processed (local) " + lastMoveCountProcessed + ", Game MoveCount (current) " + newGame.MoveCount);
        }

        GameId = gameDto.GameId;
        Data.ChatList.Instance = gameDto.Chat_Dto;
        highestChatSeen = gameDto.HighestChatSeen;
        MessageForLocalHuman = newGame.LastMoveResult;

        var myPlayer = FindSelf(newGame);
        if (myPlayer == null)
        {
            MessageForLocalHuman = $"Lost game consistency: player Email";
            return;
        }
        MyMove = myPlayer.MyTurn;

        // check if we are in a strigiform situation and act accordingly
        if (saveGameStateDto == null)  // no owl
        {
            //CheckTheTileSituation(myPlayer.Tiles);
            SetTilesInRack(myPlayer.Tiles);

            // Assume all tiles are newly created - reenable drag & drop
            for (int i = 0; i < TilesInRack.Count; i++)
            {
                var tile = TilesInRack[i];
                //Console.WriteLine("set for drop : " + tile.ID);
                actionsToRunAfterRender.Add((JS_SetTileForDrop, tile.ID));
            }

            // remove event listeners for squares with newly pinned tiles
            if (lastMoveCountProcessed > -1)
            {
                string idList = "";
                for (int i = 0; i < newGame.RecentMoves.Count; i++)
                {
                    //Console.WriteLine(newGame.RecentMoves[i]);
                    if (newGame.RecentMoves[i].Contains(":"))
                    {
                        string [] recentMovesArray = newGame.RecentMoves[i].Split(":"); 
                        int recentMovesCount = Int32.Parse(recentMovesArray[0]);
                        // avoid processing previous moves
                        if (recentMovesCount > lastMoveCountProcessed)
                        {
                            Console.WriteLine(newGame.RecentMoves[i]);
                            for (int j = 1; j < recentMovesArray.Length; j++)
                            {
                                idList = idList + recentMovesArray[j] + ";";
                            }
                            lastMoveCountProcessed = recentMovesCount;
                        }
                    }
                }
                if (idList.Length > 0)
                {
                    if (idList.EndsWith(";"))
                        idList = idList.TrimEnd(';');
                    //Console.WriteLine("ID list is '" + idList + "'");
                    actionsToRunAfterRender.Add((JS_RmEventListenerForIdList, idList));
                }
            }
        }

        WordInPlay.Clear();
        validMove = false;

        if (!MyMove)
        {
            // Update list of unplayed games
            var games = await Http.GetFromJsonAsync<List<GameSummaryDto>>($"/api/GameList");
            MyGamesList.CreateMyUnplayedGameList(games);
        }

        if (newGame.FinalGameStatus == null)
        {
            if (!initialLoad)
            {
                await PlaySound("GuitarStrum.mp3");
            }
        }
        else
        {
            // game over
            await PlaySound("GameOver.mp3");
        }
        initialLoad = false;
    }

    private void CheckTheTileSituation(List<Tile> listOfTiles)
    {
        // utility function for debugging
        // there is TilesInRack - what the client has in place
        // there is listOfTiles - what the server just sent us
        // dump out both lists
        // identify new tiles, tiles in a different position and tiles in the same position

        if (listOfTiles != null)
        {
            Console.WriteLine("Tile Count : (from server) " + listOfTiles.Count);
            for (int i = 0; i < listOfTiles.Count; i++)
            {
                Console.WriteLine(i + "." + listOfTiles[i].ID + " [" + listOfTiles[i].Letter + "]");
            }
        }

        if (TilesInRack != null)
        {
            Console.WriteLine("Tile Count : (local rack) " + TilesInRack.Count);
            for (int i = 0; i < TilesInRack.Count; i++)
            {
                Console.WriteLine(i + "." + TilesInRack[i].ID + " [" + TilesInRack[i].Letter + "]");
            }
        }

        // build a list of tiles that have been added to the rack
        //List<Tile> addedTiles = new List<Tile> ();

        for (int i = 0; i < listOfTiles.Count; i++)
        {
            var rackTileIndex = FindTileById(TilesInRack, listOfTiles[i].ID);
            if (rackTileIndex < 0)
            {
                // it's a new tile
                Console.WriteLine("New rack tile : " + listOfTiles[i].ID + " [" + listOfTiles[i].Letter + "]");
                //addedTiles.Add(listOfTiles[i]);
                continue;
            }
            if (rackTileIndex == i)
            {
                // it's an existing tile in the same location on the rack
                Console.WriteLine("Existing rack tile : " + listOfTiles[i].ID + " [" + listOfTiles[i].Letter + "] @ " + i);
                continue;
            }

            Console.WriteLine("Existing rack tile (different position): " + listOfTiles[i].ID +
                              " [" + listOfTiles[i].Letter + "] now @ " + rackTileIndex + " vs. " + i);
        }
    }

    /// <summary>
    /// Set TilesInRack pointer; tiles may have been shuffled locally while waiting on partner
    /// players move.  Retain tile order when new game state comes back from server.
    /// Tiles may have been added or exchanged from the turn.
    /// </summary>
    /// <param name="newTiles">
    private void SetTilesInRack(List<Tile> listOfTiles)
    {
        if (TilesInRack == null){
            // First assignment
            TilesInRack = listOfTiles;
            return;
        }

        for (int i=0; i < listOfTiles.Count && i < TilesInRack.Count; i++)
        {
            var oldTileIndex = FindTileById(listOfTiles, TilesInRack[i].ID);
            if (oldTileIndex < 0 || oldTileIndex == i) continue;

            // An existing tile that's been shuffled - Swap tiles to match
            var tempTile = listOfTiles[i];
            listOfTiles[i] = listOfTiles[oldTileIndex];
            listOfTiles[oldTileIndex] = tempTile;
        }
    
        TilesInRack = listOfTiles;
    }

    /// <summary>
    /// Search tile list for Id
    /// </summary>
    /// <param name="tileList">
    /// <param name="tileId">
    /// <returns></returns>
    private int FindTileById(List<Tile> tileList, string tileId)
    {
        var foundIndex = -1;
        if (tileList == null)
            return foundIndex;

        for (int i = 0; i < tileList.Count; i++)
        {
            if (tileList[i].ID == tileId)
            {
                return i;
            }
        }
        return foundIndex;
    }

    private async Task Rematch()
    {
        // Definition of rematch is to submit the same players again for new game

        var playerIdList = new List<int>();
        var skill_level = -1;
        foreach (var player in currentGame.Players)
        {
            playerIdList.Add(player.PlayerId);
            if (player is ComputerPlayer) skill_level = player.Skill;
        }
        playerIdList.Shuffle(); // Randomize order, even if challenger goes first

        try
        {
            Console.WriteLine(" ");
            Console.WriteLine("Rematch requested");
            Console.WriteLine($"Starting new game with {playerIdList.Count} players");
            if (skill_level > -1)
                Console.WriteLine("Computer player skill level : " + skill_level);
            Console.WriteLine("Owl assisted ? " + currentGame.AllowOwl);

            IsSubmitting = true;
            // make sure the rematch game has same attributes as the current game now that
            // use of owl and computer skill level can be specified
            // we'll probably have to cycle through opponents to see if there is a Computer in the mix
            // and if so what skill level it has
            // it would be better if we could ask the server to clone the existing game in some way
            // but for now this will do the job...
            var uri = $"/api/NewGame?skill={(int)skill_level}&owl={currentGame.AllowOwl}";

            var response = await Http.PostAsJsonAsync<List<int>>(uri, playerIdList);
            if (!response.IsSuccessStatusCode)
            {
                MessageForLocalHuman = $"Unable to start game, code: {response.StatusCode.ToString()}";
                isSubmitting = false;
                return;
            }

            var newGameId = await response.Content.ReadFromJsonAsync<int>();

            // Notify other possible player(s) logged into this finished game that the rematch has been issued
            // so that multiple players don't rematch into new / different games
            await hubConnection.InvokeAsync("BroadcastRematchGame", GameId, newGameId);

            NavigationManager.NavigateTo($"/game/{newGameId}");
        }
        catch (Exception ex)
        {
            MessageForLocalHuman = $"Something went wrong: {ex.Message}";
            Console.WriteLine(ex.ToString());
        }
        IsSubmitting = false;
        StateHasChanged();
    }

    private async Task SetupHub()
    {
        hubConnection = new HubConnectionBuilder()
        .WithUrl(NavigationManager.ToAbsoluteUri("/movehub"))
        .WithAutomaticReconnect(new TimeSpan[]
        {
            TimeSpan.Zero,
            TimeSpan.FromSeconds(2),
            TimeSpan.FromSeconds(10),
            TimeSpan.FromSeconds(30),
            TimeSpan.FromSeconds(60),
            TimeSpan.FromSeconds(90),
            TimeSpan.FromSeconds(120),
            TimeSpan.FromSeconds(180)
        })
        .Build();

        hubConnection.Reconnecting += (exception) =>
        {
            Console.WriteLine($"Hub Connection started reconnecting due to an error: {exception}");
            return Task.CompletedTask;
        };

        hubConnection.Reconnected += async (connectionId) =>
        {
            Console.WriteLine($"Hub Connection successfully reconnected. The ConnectionId is now: {connectionId}");
            await SetGameIdAsync();
        };

        hubConnection.Closed += (exception) =>
        {
            if (exception == null)
            {
                Console.WriteLine("Hub Connection closed without error.");
            }
            else
            {
                Console.WriteLine($"Hub Connection closed due to an error: {exception}");
            }
            return Task.CompletedTask;
        };

        hubConnection.On<int>("ClientReceiveMove", async (gameId) =>
        {
            // Opponent has made a move
            await InvokeAsync(async () =>
            {
                GameId = gameId;
                Console.WriteLine($"ClientReceiveMove for game {gameId}");
                if (saveGameStateDto != null)
                {
                    Console.WriteLine("WARNING - game updated while OWL deployed");
                    Console.WriteLine("WARNING - savedGameStateDto will be out of sync");
                    saveGameStateDto = null;
                    return;
                }
                await BuildGame();
                StateHasChanged();
                if (currentGame.FinalGameStatus == null)
                {
                    await PlaySound("ScrabbleDrop.mp3");
                }
                else
                {
                    // game over
                    await PlaySound("GameOver.mp3");
                }
            }

            );
        });

        // Chat message just created
        hubConnection.On<ChatDto>("ClientReceiveChat", async (chat) =>
                {
                    Data.ChatList.Instance.Add(chat);
                    if (chatParameters != null && chatParameters.NewMessageRefresh != null)
                    {
                        // Play sound only if chat from other player
                        if (chat.PlayerId != AuthCache.CachedPlayer.PlayerId)
                        {
                            await PlaySound("ComedicWhistle.mp3");
                        }
                        chatParameters.NewMessageRefresh();
                    } else
                    {
                        await PlaySound("ComedicWhistle.mp3");
                        StateHasChanged();
                    }
                });

        //
        // An opponent has invoked the rematch challenge for this game
        hubConnection.On<int>("ClientRematch", async (newGameId) =>
                {
                    NavigationManager.NavigateTo($"/game/{newGameId}");
                });

        // just want to make sure this part of the code only gets executed once per load of game page
        // and not after any of the above callbacks have been called. i'm pretty sure it won't but this will help
        // spot anything odd
        Console.WriteLine(" ");
        Console.WriteLine("*****************");
        Console.WriteLine("*** SETUP HUB ***");
        Console.WriteLine("*****************");
        Console.WriteLine(" ");
    }

    public string PrintTimeSpan(TimeSpan t)
    {
       if (t == TimeSpan.Zero) return string.Empty;

       string answer;
       if (t.TotalSeconds < 1.0)
       {
         answer = String.Format("{0}ms", t.Milliseconds);
       }
       else if (t.TotalMinutes < 1.0)
       {
         answer = String.Format("{0}s", t.Seconds);
       }
       else if (t.TotalHours < 1.0)
       {
         answer = String.Format("{0}m {1}s", t.Minutes, t.Seconds);
       }
       else if (t.TotalDays < 1.0)
       {
         answer = String.Format("{0}h {1}m {2}s", t.Hours, t.Minutes, t.Seconds);
       }
       else
       {
         answer = String.Format("{0}d {1}h {2}m {3}s", t.Days, t.Hours, t.Minutes, t.Seconds);
       }

       return answer;
    }
