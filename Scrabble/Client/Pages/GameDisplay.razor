    private string GetProfessorMessage(int playerScore, int computerScore, ref bool displayComputerPlay)
    {
        displayComputerPlay = false;
        Random rnd = new Random();

        if (playerScore == computerScore)
        {
            var adjectives = new List<string> {"Splendid", "Impressive", "Superb", "Excellent" };
            int randIndex = rnd.Next(adjectives.Count);
            string superlative = adjectives[randIndex];

            return $"{superlative}! I couldn't have done better myself.";
        }

        displayComputerPlay = true;
        if (playerScore > computerScore)
        {
            var adjectives = new List<string> { "Dazzling", "Brilliant", "Magnificent", "Marvelous" };
            int randIndex = rnd.Next(adjectives.Count);
            string superlative = adjectives[randIndex];

            return $"{superlative}! You did even better than I could have.";
        }

        var advice = "Not bad -";
        var scoreDiff = computerScore - playerScore;
        if (scoreDiff < 5)
        {
            advice = "Good effort -";
        } else if (scoreDiff < 10)
        {
            advice = "Not bad -";
        } else
        {
            advice = "";
        }

        return $"{advice} What about this though?";
    }


