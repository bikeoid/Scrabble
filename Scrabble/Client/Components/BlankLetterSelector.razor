<div class="container">
	<div class="row">
		<div class="col">
			@for (int i = 0; i < 26; i++)
			{
				var letter = (char)('A' + i);
				<div class="blank-letter-selector" @onclick="() => Submit(letter)">@letter</div>
				<!-- forces a new line after every 8 tiles, 3 x 8 + 2 = 26 letters -->
				@if ((i + 1) % 8 == 0)
				{
					<div class="w-100"></div>
				}
			}
			<div class="w-100"></div>
		</div>
	</div>
</div>

@code
{
	[CascadingParameter] BlazoredModalInstance BlazoredModal { get; set; }

	async Task Submit(char letter)
	{
		await BlazoredModal.CloseAsync(ModalResult.Ok<char>((char)(letter + ('a' - 'A'))));
	}
}