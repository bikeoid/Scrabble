<div class="container">
	<div class="row">
		@for (int i = 0; i < 26; i++)
		{
			var letter = (char)('A' + i);
			<div class="col-auto gx-2 gy-2">
				<div class="blank-tile-selection" @onclick="() => Submit(letter)">@letter</div>
			</div>
			<!-- forces a new line after every 8 tiles -->
			@if ((i + 1) % 8 == 0)
			{
				<div class="w-100"></div>
			}
		}
	</div>
</div>

@code
{
	[CascadingParameter] BlazoredModalInstance BlazoredModal { get; set; }

	async Task Submit(char letter)
	{
		await BlazoredModal.CloseAsync(ModalResult.Ok<char>((char)(letter + ('a' - 'A'))));
    }
}
