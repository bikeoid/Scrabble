@inject HttpClient Http

@using System.Net
@using System.Linq;

<div class="container">
    <div class="alert alert-danger" role="alert" hidden="@HideAlert">
        @errorMessage
    </div>
    <div class="row">
        <p>Select up to 3 players to challenge to a new game:</p>
    </div>
    <div class="row">
        @if (opponents == null)
        {
            <span>Getting Players list</span>
        }
        else
        {
            <div class="col">
            @foreach (var playerInfo in opponents)
            {
                if (playerInfo.Player.IsPlayer)
                {
                    <div>
                        <InputCheckbox @bind-Value=@playerInfo.Selected @bind-Value:after="() => CheckboxChanged_after(playerInfo)" />
                        @playerInfo.Player.Name
                    </div>
                }
                if (playerInfo.Player.IsComputerPlayer && playerInfo.Selected)
                {
                    <fieldset>
                        <InputRadioGroup @bind-Value=@proficiency.Level>
                            @foreach (var skilllevel in Enum.GetValues<Level>())
                            {
                                var disabled_flag = !@playerInfo.Selected;
                                <div class="computerlevel-indent">
                                    <InputRadio Value=skilllevel disabled=@disabled_flag/> @skilllevel
                                </div>
                            }
                        </InputRadioGroup>
                    </fieldset>
                }
            }
            </div>
            <div class="col align-self-end d-flex justify-content-end">
                @{string owl_is = owlDisabled ? "invisible" : "visible";}
                <div class=@($"{owl_is}")>
                    <InputCheckbox @bind-Value=@owlSelected disabled=@owlDisabled @oninput="OwlCheckboxChanged" />
                    <span class="owl-checkbox-icon"></span> 
                </div>
            </div>
        }
    </div>

    <div class="row">
        <p></p>
    </div>

    <div class="row">
        <p>
            <button @onclick="Submit" class="btn btn-success" disabled=@ButtonDisabled>Start Game</button>
        </p>
    </div>
</div>


@code {

    List<SelectedPlayer> opponents;
    int numOpponents = 0;

    // initial values for owl widget
    bool owlDisabled = true;
    bool owlSelected = false;

    int myPlayerId;

    private string errorMessage;

    public int NewGameId { get; set; } = -1;

    private bool ButtonDisabled => (numOpponents <1 || numOpponents >3);
    [CascadingParameter] BlazoredModalInstance BlazoredModal { get; set; }
    private bool HideAlert{ get; set; }

    // Get access to claims
    [CascadingParameter] private Task<AuthenticationState> authenticationStateTask { get; set; }

    protected override async Task OnInitializedAsync()
    {
        HideAlert = true;
        var allPlayers = await Http.GetFromJsonAsync<List<PlayerDto>>($"/api/Players");

        var authState = await authenticationStateTask;
        var user = authState.User;

        var myEmail = user.Claims.Where(x => x.Type == AppEmailClaimType.ThisAppEmailClaimType).Select(x => x.Value).FirstOrDefault();

        var otherPlayers = new List<SelectedPlayer>();
        foreach (var player in allPlayers)
        {
            if (player.Email == myEmail)
            {
                myPlayerId = player.PlayerId;
            } else if (player.IsPlayer)
            {
                var selectedPlayer = new SelectedPlayer();
                selectedPlayer.Player = player;
                otherPlayers.Add(selectedPlayer);
            }
        }

        opponents = otherPlayers;
    }

    private void OwlCheckboxChanged(ChangeEventArgs args)
    {
        // use the owl checkbox 'selected' state to allow/disallow use of the owl
        owlSelected = (bool)args.Value;
        Console.WriteLine("owl unleashed : " + owlSelected);
    }

    private void CheckboxChanged_after(SelectedPlayer sp)
    {
        // get the checkbox state to enable/disable start button
        // and to activate or deactivate (and unselect) the owl option
        int nHumans = 0;
        int nComputers = 0;
        foreach (var oPlayer in opponents)
        {
            if (oPlayer.Selected)
            {
                if (oPlayer.Player.IsComputerPlayer)
                    nComputers++;
                else
                    nHumans++;
            }
        }

        if (nHumans > 0 && nComputers == 0)
        {
            owlDisabled = false;
        }
        else
        {
            owlSelected = false;
            owlDisabled = true;
        }

        numOpponents = nHumans + nComputers;
        Console.WriteLine("humans:" + nHumans + " computers:" + nComputers + " total:" + numOpponents +
                          " owl selected:" + owlSelected + " owlDisabled:" + owlDisabled);
    }

    private async Task Submit()
    {
        errorMessage = "";
        var playerIdList = new List<int>();
        playerIdList.Add(myPlayerId);
        var hasComputerPlayer = false;
        foreach(var player in opponents)
        {
            if (player.Selected)
            {
                playerIdList.Add(player.Player.PlayerId);
                if (player.Player.IsComputerPlayer) hasComputerPlayer = true;
            }
        }

        Console.WriteLine($"Starting new game with {playerIdList.Count} players");
        try
        {
            var uri = "";
            if (hasComputerPlayer)
            {
                Console.WriteLine("Computer player skill level is '" + proficiency.Level + "'");
                uri = $"/api/NewGame?skill={(int)proficiency.Level}&owl={(bool)owlSelected}";
            }
            else
            {
                uri = $"/api/NewGame?skill=-1&owl={(bool)owlSelected}";
            }
            
            var response = await Http.PostAsJsonAsync<List<int>>(uri, playerIdList);
            if (!response.IsSuccessStatusCode)
            {
                HideAlert = false;
                errorMessage = $"Unable to start game, code: {response.StatusCode.ToString()}";
                return;
            }
            NewGameId = await response.Content.ReadFromJsonAsync<int>();

            await BlazoredModal.CloseAsync(ModalResult.Ok(NewGameId));
        }catch (Exception ex)
        {
            HideAlert = false;
            errorMessage = $"Something went wrong: {ex.Message}";
            Console.WriteLine(ex.ToString());
        }
    }

    private class SelectedPlayer
    {
        public PlayerDto Player{ get; set; }
        public bool Selected{ get; set; }  // For UI selection process
    }

    public class Proficiency
    {
        public Level Level { get; set; } = Level.Intermediate; // Default selection
    }

    public enum Level
    {
        Beginner,
        Intermediate,
        Advanced,
        Expert
    }

    private Proficiency proficiency = new Proficiency();
}
